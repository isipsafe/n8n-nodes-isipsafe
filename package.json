{
	"name": "n8n-nodes-isipsafe",
	"version": "0.1.0",
	"description": "n8n community node for isIPsafe: check IP reputation, report abusive addresses and download the free blocklist",
	"license": "MIT",
	"homepage": "https://isipsafe.com/integrations",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"isipsafe",
		"ip-reputation",
		"abuse",
		"blocklist",
		"threat-intelligence",
		"security"
	],
	"author": {
		"name": "WaveCentric",
		"email": "sasi@wavecentric.ai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/isipsafe/n8n-nodes-isipsafe.git"
	},
	"bugs": {
		"url": "https://github.com/isipsafe/n8n-nodes-isipsafe/issues"
	},
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.test.json",
		"prepublishOnly": "npm run lint && npm run build && npm test",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo",
		"!dist/package.json"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/IsIpsafeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/IsIpsafe/IsIpsafe.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.6",
		"eslint": "9.39.4",
		"n8n-workflow": "2.16.0",
		"prettier": "3.8.3",
		"typescript": "5.9.3",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
